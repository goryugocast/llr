{
  "name": "obsidian-llr-plugin",
  "version": "0.5.2",
  "description": "LLR: Live Life Recording system for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:sync": "OBSIDIAN_SYNC_ON_BUILD=1 node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:sync": "OBSIDIAN_SYNC_ON_BUILD=1 node esbuild.config.mjs production",
    "deploy": "OBSIDIAN_SYNC_ON_BUILD=1 node esbuild.config.mjs production && obsidian plugin:reload id=llr",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "changelog:update": "bash scripts/update_changelog.sh",
    "test:reflection:obsidian": "node scripts/test_reflection_runtime.mjs"
  },
  "overrides": {
    "@microsoft/eslint-plugin-sdl": {
      "eslint-plugin-n": "18.5.0"
    },
    "eslint-plugin-obsidianmd": {
      "eslint-plugin-json-schema-validator": {
        ".": "6.3.2",
        "minimatch": "11.0.9"
      },
      "obsidian": {
        "moment": "2.31.0"
      }
    }
  },
  "keywords": [
    "obsidian",
    "plugin",
    "llr"
  ],
  "author": "goryugo",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "happy-dom": "21.0.4",
    "obsidian": "^1.7.0",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}
